<script>
/* ============ DATA ============ */
const GURU=[
  {icon:"📐",m:"Matematika Wajib",n:"Ibu Dwi Ayu Apriani, S.Pd.Gr.",j:"Jumat & Sabtu",k:"Guru Mapel"},
  {icon:"📏",m:"Matematika Tingkat Lanjut",n:"Ibu Putri Winda Sari Batubara, S.Pd.Gr.",j:"Jumat & Sabtu",k:"Guru Mapel"},
  {icon:"⚡",m:"Fisika",n:"Bapak Henri Sasti, M.Sc.",j:"Senin & Rabu",k:"Guru Mapel"},
  {icon:"⚗️",m:"Kimia",n:"Bapak Diki Suprapto, M.Pd.Gr.",j:"Rabu & Jumat",k:"Guru Mapel"},
  {icon:"🧬",m:"Biologi",n:"Ibu Try Ade Jumita Wulandari, M.Pd.Gr.",j:"Senin & Rabu",k:"Wali Kelas"},
  {icon:"📖",m:"Bahasa Indonesia",n:"Ibu Ulfah Rani Daulay, M.Pd.Gr.",j:"Senin",k:"Guru Mapel"},
  {icon:"🌐",m:"Bahasa Inggris",n:"Ibu Raihana Sakdiyah, M.A.",j:"Rabu",k:"Guru Mapel"},
  {icon:"💻",m:"Informatika",n:"Bapak Saidina Adita Wicaksana, A.Md.Kom.",j:"Senin & Selasa",k:"Koordinator Digital"},
  {icon:"🎨",m:"Seni Budaya",n:"Ibu Nuralifia Neami Nasution, S.Pd.",j:"Sabtu",k:"Guru Mapel"},
  {icon:"🕌",m:"Bahasa Arab",n:"Bapak Muhammad Nazwir Harahap, S.Pd.",j:"Kamis",k:"Guru Mapel"},
  {icon:"🕌",m:"Sejarah Kebudayaan Islam",n:"Ibu Halimahtussa'diah, S.Pd.",j:"Senin & Sabtu",k:"Guru Mapel"},
  {icon:"🕌",m:"Fikih",n:"Bapak Risnul Hilman Siregar, S.Pd.",j:"Sabtu",k:"Guru Mapel"},
  {icon:"🕌",m:"Al‑Qur'an Hadis",n:"Ibu Lili Yuliana, S.Pd.Gr.",j:"Kamis",k:"Guru Mapel"},
  {icon:"⚖️",m:"PKN",n:"Ibu Mita Juhera, S.Pd.Gr.",j:"Kamis",k:"Guru Mapel"},
  {icon:"📜",m:"Sejarah",n:"Bapak Fiki Arul Lansyah, S.Pd.Gr.",j:"Kamis",k:"Guru Mapel"},
  {icon:"🏃",m:"PJOK",n:"Bapak Rio Agus, S.Pd.",j:"Kamis",k:"Guru Mapel"},
  {icon:"🧠",m:"BK / Konseling",n:"Bapak Hendriyal, M.Pd.Gr.",j:"Kondisional",k:"Konselor"},
];
const MURID=["Adzka Rayi Zhafira","Afifah Maahirah","Al‑Fatir Dewza","Annisa Zakiyah A.","Arel Alfachrizy","Azka Huda Adiwirya","Azkia Inda Maula","Azzkacky Al‑Mirza","Beby Al Husna","Bunga Amelia","Daim Faeyza","Elderou Ibni Alvaro","Indri Niraini Nasution","Ivany Zahira Nadin","Kaka Achmad Khedira","Khairu Umam","Lutfiah Bilqis Sianipar","Muhammad Ichsanul Arrafath","Muhammad Apta Zafran S.","Muhammad Bazli Al Hadif Lubis","Muhammad Fahri","Muhammad Ridwan Nasution","Nadira Alfyza","Najla Qois Kirana","Nur Asifa","Putri Adzkia","Radith Hamdani","Rais Al Hadi","Reihana Safira Wijaya","Rodiah Siagian","Shafa Aulia Efendi","Syakira","Taufikia Alfisyahri Al Bintari","Thahira Sabita Salman S.","Windi Riska Rahayu","Zahratunnisa Asyifa"];
const JADWAL=[
  {hari:"Senin",mapel:["Biologi","Fisika","Bahasa Indonesia","Informatika"]},
  {hari:"Selasa",mapel:["MLPP","Akidah Akhlak","MLTQ","Al‑Qur'an Hadis","Informatika"]},
  {hari:"Rabu",mapel:["Bahasa Inggris","Kimia","Biologi","Fisika"]},
  {hari:"Kamis",mapel:["Bahasa Arab","Sejarah Kebudayaan Islam","Pelajar Pancasila","Sejarah","PJOK"]},
  {hari:"Jumat",mapel:["Matematika","Kimia","Matematika Tingkat Lanjut"]},
  {hari:"Sabtu",mapel:["Fikih","Matematika Tingkat Lanjut","Seni Budaya","Sejarah Kebudayaan Islam","Matematika"]},
];
const QUOTES=[
  {t:"Ikhlas dalam berbuat adalah kunci ketenangan dalam belajar.",a:"Motivasi Kelas"},
  {t:"Kebersamaan yang tulus membuat perjuangan terasa lebih ringan.",a:"XI‑3 Saintek 1"},
  {t:"Belajar bukan soal cepat, tapi soal terus melangkah bersama.",a:"Wali Kelas"},
  {t:"Prestasi terbaik lahir dari niat yang ikhlas dan usaha yang konsisten.",a:"Motivasi Kelas"},
];
const MADING=[
  {icon:"🚌",t:"Studi Tur Angkatan",d:"Perjalanan belajar di luar kelas"},
  {icon:"🎭",t:"Pentas Seni Kelas",d:"Unjuk bakat seni dan kreativitas"},
  {icon:"🧹",t:"Kerja Bakti Bersama",d:"Gotong royong menjaga kebersihan kelas"},
  {icon:"🏆",t:"Lomba Antar Kelas",d:"Semangat kompetisi yang sehat"},
  {icon:"📚",t:"Kegiatan Literasi",d:"Membaca dan berdiskusi bersama"},
  {icon:"🌱",t:"Proyek P5",d:"Dokumentasi proyek profil pelajar Pancasila"},
];
const PRESTASI=[
  {icon:"🏆",t:"Piala Lomba Sains",d:"Juara dalam kompetisi sains tingkat sekolah."},
  {icon:"📜",t:"Piagam Penghargaan",d:"Apresiasi atas kekompakan dan disiplin kelas."},
  {icon:"✍️",t:"Puisi Karya Siswa",d:"Kumpulan puisi karya anggota kelas XI‑3."},
  {icon:"🎨",t:"Lukisan & Ilustrasi",d:"Karya seni rupa hasil kreativitas siswa."},
];
const COLORS=["#D6336C","#F186B4","#7A1943","#E8659A","#B5285C","#1E7A34"];
const initials = n => n.split(" ").slice(0,2).map(w=>w[0]).join("").toUpperCase();
const colorFor = i => COLORS[i % COLORS.length];

/* ============ NAV ============ */
const burger=document.getElementById("burger"), navlinks=document.getElementById("navlinks");
burger.addEventListener("click",()=>navlinks.classList.toggle("open"));
document.querySelectorAll(".navlinks a").forEach(a=>a.addEventListener("click",()=>{
  navlinks.classList.remove("open");
  document.querySelectorAll(".navlinks a").forEach(x=>x.classList.remove("active"));
  a.classList.add("active");
}));

/* ============ TABS (generic) ============ */
function initTabs(wrapId){
  const wrap=document.getElementById(wrapId);
  const section=wrap.closest("section");
  wrap.querySelectorAll(".tab-btn").forEach(btn=>{
    btn.addEventListener("click",()=>{
      wrap.querySelectorAll(".tab-btn").forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");
      section.querySelectorAll(".tab-panel").forEach(p=>p.classList.remove("active"));
      section.querySelector(`.tab-panel[data-panel="${btn.dataset.tab}"]`).classList.add("active");
    });
  });
}
initTabs("profilTabs");
initTabs("akTabs");

/* ============ QUOTE ROTATOR ============ */
let qIdx=0;
const quoteText=document.getElementById("quoteText"), quoteAuthor=document.getElementById("quoteAuthor"), quoteDots=document.getElementById("quoteDots");
QUOTES.forEach((_,i)=>{
  const d=document.createElement("button"); d.className="qdot"+(i===0?" active":"");
  d.addEventListener("click",()=>showQuote(i));
  quoteDots.appendChild(d);
});
function showQuote(i){
  qIdx=i;
  quoteText.textContent=`"${QUOTES[i].t}"`;
  quoteAuthor.textContent=QUOTES[i].a;
  quoteDots.querySelectorAll(".qdot").forEach((d,idx)=>d.classList.toggle("active",idx===i));
}
showQuote(0);
setInterval(()=>showQuote((qIdx+1)%QUOTES.length),5000);

/* ============ CAROUSEL (foto angkatan) ============ */
const carTrack=document.getElementById("carTrack"), carDots=document.getElementById("carDots");
const perSlide=6, slides=Math.ceil(MURID.length/perSlide);
for(let s=0;s<slides;s++){
  const slide=document.createElement("div"); slide.className="carousel-slide";
  MURID.slice(s*perSlide,s*perSlide+perSlide).forEach((n,i)=>{
    const av=document.createElement("div"); av.className="avatar";
    av.style.background=colorFor(s*perSlide+i);
    av.innerHTML=`<div>${initials(n)}<div style="font-weight:400;font-size:.6rem;margin-top:4px;">${n.split(" ")[0]}</div></div>`;
    slide.appendChild(av);
  });
  carTrack.appendChild(slide);
  const dot=document.createElement("button"); dot.className="cdot"+(s===0?" active":"");
  dot.addEventListener("click",()=>goCar(s));
  carDots.appendChild(dot);
}
let carIdx=0;
function goCar(i){
  carIdx=(i+slides)%slides;
  carTrack.style.transform=`translateX(-${carIdx*100}%)`;
  carDots.querySelectorAll(".cdot").forEach((d,idx)=>d.classList.toggle("active",idx===carIdx));
}
document.getElementById("carPrev").addEventListener("click",()=>goCar(carIdx-1));
document.getElementById("carNext").addEventListener("click",()=>goCar(carIdx+1));
setInterval(()=>goCar(carIdx+1),4500);

/* ============ TREE VIEW (struktur pengurus) ============ */
const treeData={
  n:"Ibu Try Ade Jumita Wulandari, M.Pd.Gr.",r:"Wali Kelas",children:[
    {n:"Muhammad Ridwan Nasution",r:"Ketua Kelas",children:[
      {n:"Muhammad Ichsanul Arrafath",r:"Wakil Ketua"}
    ]},
    {n:"Nur Asifa",r:"Sekretaris",children:[
      {n:"Taufikia Alfisyahri Al Bintari",r:"Wakil Sekretaris"}
    ]},
    {n:"Putri Adzkia",r:"Bendahara",children:[
      {n:"Thahira Sabita Salman S.",r:"Wakil Bendahara"}
    ]}
  ]
};
function buildTree(node){
  const li=document.createElement("li");
  const hasChildren = node.children && node.children.length;
  li.innerHTML=`<div class="tree-node">${hasChildren?'<button class="tree-toggle">−</button>':'<span style="width:20px;"></span>'}<div><b>${node.n}</b><span>${node.r}</span></div></div>`;
  if(hasChildren){
    const childWrap=document.createElement("div"); childWrap.className="tree-children open";
    const ul=document.createElement("ul"); ul.className="tree";
    node.children.forEach(c=>ul.appendChild(buildTree(c)));
    childWrap.appendChild(ul);
    li.appendChild(childWrap);
    const toggle=li.querySelector(".tree-toggle");
    toggle.addEventListener("click",()=>{
      const open=childWrap.classList.toggle("open");
      toggle.textContent=open?"−":"+";
    });
  }
  return li;
}
document.getElementById("treeRoot").appendChild(buildTree(treeData));

/* ============ ACCORDION (jadwal mingguan) ============ */
const accWrap=document.getElementById("accordionWrap");
JADWAL.forEach((d,i)=>{
  const item=document.createElement("div"); item.className="accordion-item"+(i===0?" open":"");
  item.innerHTML=`<button class="accordion-head"><span>${d.hari}</span><span class="plus">+</span></button>
    <div class="accordion-body"><div class="accordion-body-in">${d.mapel.map(m=>`<span class="pill">${m}</span>`).join("")}</div></div>`;
  item.querySelector(".accordion-head").addEventListener("click",()=>item.classList.toggle("open"));
  accWrap.appendChild(item);
});

/* ============ GURU GRID + POPOVER ============ */
const guruGrid=document.getElementById("guruGrid");
GURU.forEach(g=>{
  const card=document.createElement("div"); card.className="guru-card";
  card.innerHTML=`<div class="guru-icon">${g.icon}</div>
    <div class="guru-mini"><b>${g.m}</b><span>${g.n}</span></div>
    <div class="popover"><b>${g.n}</b>Mengajar: ${g.m}<br>Jadwal: ${g.j}<span class="k">${g.k}</span></div>`;
  const pop=card.querySelector(".popover");
  card.addEventListener("click",(e)=>{
    document.querySelectorAll(".popover.show").forEach(p=>{if(p!==pop)p.classList.remove("show");});
    pop.classList.toggle("show");
    e.stopPropagation();
  });
  guruGrid.appendChild(card);
});
document.addEventListener("click",()=>document.querySelectorAll(".popover.show").forEach(p=>p.classList.remove("show")));

/* ============ PAGINATION (daftar siswa) ============ */
const muridGrid=document.getElementById("muridGrid"), muridPag=document.getElementById("muridPagination");
const perPage=12, totalPages=Math.ceil(MURID.length/perPage);
function renderMurid(page){
  muridGrid.innerHTML="";
  MURID.slice((page-1)*perPage,(page-1)*perPage+perPage).forEach((n,i)=>{
    const idx=(page-1)*perPage+i;
    const card=document.createElement("div"); card.className="murid-card";
    card.innerHTML=`<div class="av" style="background:${colorFor(idx)}">${initials(n)}</div><b>${n}</b>`;
    muridGrid.appendChild(card);
  });
  muridPag.innerHTML="";
  const prev=document.createElement("button"); prev.className="page-btn"; prev.textContent="‹"; prev.disabled=page===1;
  prev.addEventListener("click",()=>renderMurid(page-1)); muridPag.appendChild(prev);
  for(let p=1;p<=totalPages;p++){
    const b=document.createElement("button"); b.className="page-btn"+(p===page?" active":""); b.textContent=p;
    b.addEventListener("click",()=>renderMurid(p)); muridPag.appendChild(b);
  }
  const next=document.createElement("button"); next.className="page-btn"; next.textContent="›"; next.disabled=page===totalPages;
  next.addEventListener("click",()=>renderMurid(page+1)); muridPag.appendChild(next);
}
renderMurid(1);

/* ============ MADING GALLERY ============ */
const madingGrid=document.getElementById("madingGrid");
MADING.forEach((m,i)=>{
  const c=document.createElement("div"); c.className="mading-card";
  c.innerHTML=`<div class="mading-photo" style="background:${colorFor(i)}">${m.icon}</div>
    <div class="mading-info"><b>${m.t}</b><br><span>${m.d}</span></div>`;
  madingGrid.appendChild(c);
});

/* ============ PRESTASI + RATING ============ */
const prestasiGrid=document.getElementById("prestasiGrid");
PRESTASI.forEach(p=>{
  const c=document.createElement("div"); c.className="prestasi-card";
  c.innerHTML=`<div class="prestasi-icon">${p.icon}</div><h4>${p.t}</h4><p>${p.d}</p>
    <div class="rating">${[1,2,3,4,5].map(s=>`<button class="star" data-v="${s}">★</button>`).join("")}<span class="rating-label">Beri nilai</span></div>`;
  const stars=c.querySelectorAll(".star"); const label=c.querySelector(".rating-label");
  stars.forEach(st=>st.addEventListener("click",()=>{
    const v=+st.dataset.v;
    stars.forEach(s=>s.classList.toggle("on",+s.dataset.v<=v));
    label.textContent=v+"/5 ⭐";
  }));
  prestasiGrid.appendChild(c);
});

/* ============ TOAST ============ */
const toast=document.getElementById("toast");
function showToast(msg){
  toast.textContent=msg; toast.classList.add("show");
  setTimeout(()=>toast.classList.remove("show"),2600);
}
document.getElementById("curhatSubmit").addEventListener("click",()=>{
  const val=document.getElementById("curhatText").value.trim();
  if(!val){showToast("Tulis dulu curhatanmu ya 🌷");return;}
  document.getElementById("curhatText").value="";
  showToast("Curhatanmu terkirim secara anonim 🌸");
});
document.getElementById("kontakSubmit").addEventListener("click",(e)=>{
  e.preventDefault();
  showToast("Pesan berhasil dikirim 🌸");
});

/* ============ SCROLLSPY ============ */
const secs=[...document.querySelectorAll("section[id]")];
window.addEventListener("scroll",()=>{
  let cur="beranda";
  secs.forEach(s=>{ if(window.scrollY+120>=s.offsetTop) cur=s.id; });
  document.querySelectorAll(".navlinks a").forEach(a=>{
    a.classList.toggle("active", a.getAttribute("href")==="#"+cur);
  });
});
</script>
</body>
</html>
